#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "winzoo.ico"

1 RT_MANIFEST "manifest.xml"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Winzoo Taskbar Replacement"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "ProductName",      "Winzoo"
            VALUE "LegalCopyright",   "2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 220, 178
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Winzoo Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TAB_SETTINGS, "SysTabControl32",
                    WS_TABSTOP, 4, 4, 212, 148

    /* General tab */
    LTEXT           "Position:",           IDC_LBL_POSITION,  12,  30,  44, 10
    COMBOBOX        IDC_COMBO_POSITION,                       60,  28,  80, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Theme:",              IDC_LBL_THEME,     12,  48,  44, 10
    COMBOBOX        IDC_COMBO_THEME,                          60,  46,  80, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Bar thickness (px):", IDC_LBL_THICKNESS, 12,  66,  82, 10
    EDITTEXT        IDC_EDIT_THICKNESS,                       96,  64,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_THICKNESS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 64, 12, 12

    /* App Buttons tab */
    LTEXT           "Max btn width (px):", IDC_LBL_MAXBTNW,   12,  30,  82, 10
    EDITTEXT        IDC_EDIT_MAXBTNW,                         96,  28,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_MAXBTNW, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 28, 12, 12

    LTEXT           "Min btn width (px):", IDC_LBL_MINBTNW,   12,  46,  82, 10
    EDITTEXT        IDC_EDIT_MINBTNW,                         96,  44,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_MINBTNW, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 44, 12, 12

    CONTROL         "Middle-click closes window", IDC_CHECK_MIDDLECLICK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 62, 148, 10

    CONTROL         "Show right-click gap when no clock", IDC_CHECK_RIGHTCLICKGAP,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 76, 180, 10

    /* System Clock tab */
    CONTROL         "Show clock", IDC_CHECK_SHOWCLOCK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 28, 80, 12

    LTEXT           "Time format:",     IDC_LBL_TIMEFMT,   12,  46,  52, 10
    EDITTEXT        IDC_EDIT_TIMEFMT,                      68,  44,  92, 12,
                    ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Date format:",     IDC_LBL_DATEFMT,   12,  62,  52, 10
    EDITTEXT        IDC_EDIT_DATEFMT,                      68,  60,  92, 12,
                    ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Clock width (px):", IDC_LBL_CLOCKW,   12,  78,  70, 10
    EDITTEXT        IDC_EDIT_CLOCKW,                       84,  76,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_CLOCKW, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    112, 76, 12, 12

    LTEXT           "Tokens — time: $hh $mm $ss  date: $dd $mm $yyyy $yy",
                    IDC_LBL_TOKENS, 12, 96, 200, 16

    DEFPUSHBUTTON   "OK",     IDOK,     110, 158, 46, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 158, 46, 14
END
