#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "winzoo.ico"

1 RT_MANIFEST "manifest.xml"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Winzoo Taskbar Replacement"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "ProductName",      "Winzoo"
            VALUE "LegalCopyright",   "2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 220, 116
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Winzoo Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Position:",        -1,              8,  12, 44, 10
    COMBOBOX        IDC_COMBO_POSITION,                 56,  10, 80, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Theme:",           -1,              8,  30, 44, 10
    COMBOBOX        IDC_COMBO_THEME,                    56,  28, 80, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Bar thickness:",   -1,              8,  48, 60, 10
    EDITTEXT        IDC_EDIT_THICKNESS,                 72,  46, 30, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_THICKNESS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    100, 46, 12, 12

    CONTROL         "Middle-click closes window", IDC_CHECK_MIDDLECLICK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 64, 140, 10

    DEFPUSHBUTTON   "OK",     IDOK,     110, 96, 46, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 96, 46, 14
END
