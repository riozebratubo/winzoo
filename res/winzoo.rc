#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "winzoo.ico"

1 RT_MANIFEST "manifest.xml"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Winzoo Taskbar Replacement"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "ProductName",      "Winzoo"
            VALUE "LegalCopyright",   "2026"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 220, 248
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Winzoo Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TAB_SETTINGS, "SysTabControl32",
                    WS_TABSTOP, 4, 4, 212, 204

    /* General tab */
    LTEXT           "Position:",           IDC_LBL_POSITION,  12,  30,  44, 10
    COMBOBOX        IDC_COMBO_POSITION,                       60,  28,  80, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Bar thickness (px):", IDC_LBL_THICKNESS, 12,  48,  82, 10
    EDITTEXT        IDC_EDIT_THICKNESS,                       96,  46,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_THICKNESS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 46, 12, 12

    LTEXT           "Show taskbar:",       IDC_LBL_TASKBAR_MONITOR, 12, 66,  54, 10
    COMBOBOX        IDC_COMBO_TASKBAR_MONITOR,                       70, 64, 100, 50,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL         "Show App Menu on all monitors", IDC_CHECK_APPMENU_ALL_MONITORS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 82, 164, 10

    CONTROL         "Show buttons for current monitor apps only", IDC_CHECK_CURRENT_MONITOR_APPS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 96, 192, 10

    CONTROL         "Pinned apps: separate per monitor", IDC_CHECK_PINNED_PER_MONITOR,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 110, 192, 10

    CONTROL         "Open launched apps/dialogs on same monitor", IDC_CHECK_OPEN_SAME_MONITOR,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 124, 192, 10

    CONTROL         "Show app titles in left/right position", IDC_CHECK_VERTICAL_TITLES,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 140, 192, 10

    LTEXT           "Title button height (px):", IDC_LBL_VERTICAL_BTN_H, 28, 158, 90, 10
    EDITTEXT        IDC_EDIT_VERTICAL_BTN_H,                             120, 156, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_VERTICAL_BTN_H, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    148, 156, 12, 12

    /* System Tray tab */
    CONTROL         "Show tray icons (notification area)", IDC_CHECK_TRAY_ICONS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 28, 192, 10

    CONTROL         "Fallback to app exe icon when tray icon unavailable", IDC_CHECK_TRAY_FALLBACK_EXE,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 42, 210, 10

    CONTROL         "Show overflow (hidden) tray icons", IDC_CHECK_TRAY_OVERFLOW,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 56, 184, 10

    LTEXT           "Icon size (px):",         IDC_LBL_TRAY_ICON_SIZE,    12, 74, 90, 10
    EDITTEXT        IDC_EDIT_TRAY_ICON_SIZE,                              116, 72, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_TRAY_ICON_SIZE, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    144, 72, 12, 12

    LTEXT           "Icon padding (px):",      IDC_LBL_TRAY_ICON_PADDING, 12, 90, 90, 10
    EDITTEXT        IDC_EDIT_TRAY_ICON_PADDING,                           116, 88, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_TRAY_ICON_PADDING, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    144, 88, 12, 12

    LTEXT           "Gap between icons (px):", IDC_LBL_TRAY_ICON_MARGIN,  12, 106, 90, 10
    EDITTEXT        IDC_EDIT_TRAY_ICON_MARGIN,                            116, 104, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_TRAY_ICON_MARGIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    144, 104, 12, 12

    CONTROL         "Show winzoo custom system tray space", IDC_CHECK_STATUS_ZONE,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 122, 192, 10

    CONTROL         "Show winzoo custom sound and network icons", IDC_CHECK_HIDE_DEFAULT_TRAY_ICONS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 136, 184, 10

    /* App Buttons tab */
    LTEXT           "Max btn width (px):", IDC_LBL_MAXBTNW,   12,  30,  82, 10
    EDITTEXT        IDC_EDIT_MAXBTNW,                         96,  28,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_MAXBTNW, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 28, 12, 12

    LTEXT           "Min btn width (px):", IDC_LBL_MINBTNW,   12,  46,  82, 10
    EDITTEXT        IDC_EDIT_MINBTNW,                         96,  44,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_MINBTNW, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 44, 12, 12

    LTEXT           "Icon size (px):", IDC_LBL_APP_BTN_ICON_SZ,  12,  62,  82, 10
    EDITTEXT        IDC_EDIT_APP_BTN_ICON_SZ,                     96,  60,  28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APP_BTN_ICON_SZ, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 60, 12, 12

    CONTROL         "Middle-click closes window", IDC_CHECK_MIDDLECLICK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 78, 148, 10

    CONTROL         "Show right-click gap when no clock", IDC_CHECK_RIGHTCLICKGAP,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 92, 180, 10

    CONTROL         "Show minimized indicator", IDC_CHECK_MINIMIZED_INDICATOR,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 106, 140, 10

    LTEXT           "Indicator type:",        IDC_LBL_MINIMIZED_INDICATOR_TYPE, 12, 122, 56, 10
    COMBOBOX        IDC_COMBO_MINIMIZED_INDICATOR_TYPE,                         70, 120, 120, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Indicator width (px):",  IDC_LBL_MINIMIZED_INDICATOR_W,  12, 138, 82, 10
    EDITTEXT        IDC_EDIT_MINIMIZED_INDICATOR_W,                            96, 136, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_MINIMIZED_INDICATOR_W, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 136, 12, 12

    LTEXT           "Indicator height (px):", IDC_LBL_MINIMIZED_INDICATOR_H,  12, 154, 82, 10
    EDITTEXT        IDC_EDIT_MINIMIZED_INDICATOR_H,                            96, 152, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_MINIMIZED_INDICATOR_H, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    124, 152, 12, 12

    CONTROL         "Pinned apps as buttons even if the apps are open", IDC_CHECK_PINNED_AS_BUTTONS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 170, 192, 10

    CONTROL         "Show progress bars", IDC_CHECK_PROGRESSBAR,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 186, 140, 10

    CONTROL         "Use theme color", IDC_CHECK_PROGRESSBAR_THEMECLR,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 200, 120, 10

    LTEXT           "Color:", IDC_LBL_PROGRESSBAR_COLOR, 20, 216, 28, 10
    CONTROL         "", IDC_BTN_PROGRESSBAR_COLOR, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 52, 214, 44, 12

    LTEXT           "Height (px):", IDC_LBL_PROGRESSBAR_HEIGHT, 20, 232, 56, 10
    EDITTEXT        IDC_EDIT_PROGRESSBAR_HEIGHT,                 78, 230, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_PROGRESSBAR_HEIGHT, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    100, 230, 12, 12

    LTEXT           "Outline radius (px):", IDC_LBL_BTN_OUTLINE_RADIUS, 12, 250, 80, 10
    EDITTEXT        IDC_EDIT_BTN_OUTLINE_RADIUS,                         96, 248, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_BTN_OUTLINE_RADIUS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    118, 248, 12, 12

    CONTROL         "Show pinned apps as buttons", IDC_CHECK_SHOW_PINNED_AS_BUTTONS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 266, 148, 10

    CONTROL         "Show separator lines", IDC_CHECK_SHOW_SEPARATORS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 282, 148, 10

    LTEXT           "Color:", IDC_LBL_SEPARATOR_COLOR, 20, 298, 28, 10
    CONTROL         "", IDC_BTN_SEPARATOR_COLOR, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 52, 296, 44, 12

    /* System Clock tab */
    CONTROL         "Show clock", IDC_CHECK_SHOWCLOCK,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 28, 80, 12

    LTEXT           "Time format:",     IDC_LBL_TIMEFMT,   12,  46,  52, 10
    EDITTEXT        IDC_EDIT_TIMEFMT,                      68,  44,  92, 12,
                    ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Date format:",     IDC_LBL_DATEFMT,   12,  62,  52, 10
    EDITTEXT        IDC_EDIT_DATEFMT,                      68,  60,  92, 12,
                    ES_AUTOHSCROLL | WS_TABSTOP

    LTEXT           "Clock width (px):", IDC_LBL_CLOCKW,   12,  78,  70, 10
    EDITTEXT        IDC_EDIT_CLOCKW,                       84,  76,  22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_CLOCKW, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    106, 76, 12, 12
    LTEXT           "Spacing (px):", IDC_LBL_LINESPACING, 122, 78, 46, 10
    EDITTEXT        IDC_EDIT_LINESPACING,                  170, 76, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_LINESPACING, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    192, 76, 12, 12

    LTEXT           "Time size (pt):", IDC_LBL_TIMEFONTSIZE, 12,  94,  62, 10
    EDITTEXT        IDC_EDIT_TIMEFONTSIZE,                   76,  92,  22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_TIMEFONTSIZE, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    98, 92, 12, 12
    LTEXT           "Time color:", IDC_LBL_TIMECOLOR, 116, 94, 32, 10
    CONTROL         "", IDC_BTN_TIMECOLOR, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 150, 92, 44, 12

    LTEXT           "Date size (pt):", IDC_LBL_DATEFONTSIZE, 12, 110,  62, 10
    EDITTEXT        IDC_EDIT_DATEFONTSIZE,                   76, 108,  22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_DATEFONTSIZE, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    98, 108, 12, 12
    LTEXT           "Date color:", IDC_LBL_DATECOLOR, 116, 110, 32, 10
    CONTROL         "", IDC_BTN_DATECOLOR, "Button",
                    BS_OWNERDRAW | WS_TABSTOP, 150, 108, 44, 12

    LTEXT           "Tokens for time: $hh $mm $ss / date: $dd $mm $yyyy $yy",
                    IDC_LBL_TOKENS, 12, 126, 200, 16

    /* App Menu tab */
    LTEXT           "Layout:",             IDC_LBL_APPMENU_LAYOUT,     12, 30, 46, 10
    COMBOBOX        IDC_COMBO_APPMENU_LAYOUT,                           62, 28, 80, 60,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Menu width (px):",    IDC_LBL_APPMENU_WIDTH,      12, 46, 70, 10
    EDITTEXT        IDC_EDIT_APPMENU_WIDTH,                             84, 44, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_WIDTH, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    112, 44, 12, 12

    LTEXT           "Max height (px):",    IDC_LBL_APPMENU_MAXHEIGHT,  12, 62, 70, 10
    EDITTEXT        IDC_EDIT_APPMENU_MAXHEIGHT,                        84, 60, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_MAXHEIGHT, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    112, 60, 12, 12

    LTEXT           "Row height (px):",    IDC_LBL_APPMENU_ENTRYH,     12, 78, 70, 10
    EDITTEXT        IDC_EDIT_APPMENU_ENTRYH,                           84, 76, 28, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_ENTRYH, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    112, 76, 12, 12

    LTEXT           "Grid cols:",          IDC_LBL_APPMENU_GRIDCOLS,  130, 46, 40, 10
    EDITTEXT        IDC_EDIT_APPMENU_GRIDCOLS,                        172, 44, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_GRIDCOLS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    194, 44, 12, 12

    LTEXT           "Grid rows:",          IDC_LBL_APPMENU_GRIDROWS,  130, 62, 40, 10
    EDITTEXT        IDC_EDIT_APPMENU_GRIDROWS,                        172, 60, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_GRIDROWS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    194, 60, 12, 12

    LTEXT           "List font (pt):",     IDC_LBL_APPMENU_LISTFS,    12,  94, 62, 10
    EDITTEXT        IDC_EDIT_APPMENU_LISTFS,                          76,  92, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_LISTFS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    98,  92, 12, 12

    LTEXT           "Grid font (pt):",     IDC_LBL_APPMENU_GRIDFS,   116,  94, 62, 10
    EDITTEXT        IDC_EDIT_APPMENU_GRIDFS,                         180,  92, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_GRIDFS, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    202,  92, 12, 12

    LTEXT           "Margin (px):",        IDC_LBL_APPMENU_MARGIN,    12, 110, 60, 10
    EDITTEXT        IDC_EDIT_APPMENU_MARGIN,                          76, 108, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_MARGIN, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    98, 108, 12, 12

    LTEXT           "Padding (px):",       IDC_LBL_APPMENU_PADDING,   12, 126, 60, 10
    EDITTEXT        IDC_EDIT_APPMENU_PADDING,                         76, 124, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_PADDING, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    98, 124, 12, 12

    CONTROL         "Show sidebar", IDC_CHECK_APPMENU_SIDEBAR,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 142, 80, 10

    LTEXT           "Sidebar width (px):", IDC_LBL_APPMENU_SIDEBARW,   12, 158, 78, 10
    EDITTEXT        IDC_EDIT_APPMENU_SIDEBARW,                          92, 156, 22, 12,
                    ES_NUMBER | WS_TABSTOP
    CONTROL         "", IDC_SPIN_APPMENU_SIDEBARW, "msctls_updown32",
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS,
                    114, 156, 12, 12

    CONTROL         "Show Explorer button", IDC_CHECK_APPMENU_SIDEBAR_EXPLORER,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 172, 120, 10

    CONTROL         "Show Settings button", IDC_CHECK_APPMENU_SIDEBAR_SETTINGS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 184, 120, 10

    CONTROL         "Show Power button", IDC_CHECK_APPMENU_SIDEBAR_POWER,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 196, 120, 10

    CONTROL         "Flatten apps submenus", IDC_CHECK_APPMENU_FLATTEN_SUBMENUS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 210, 140, 10

    CONTROL         "Flatten the whole apps list", IDC_CHECK_APPMENU_FLATTEN_ALL,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 224, 140, 10

    CONTROL         "Show search box", IDC_CHECK_APPMENU_SEARCH,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 238, 140, 10

    CONTROL         "Use fuzzy search", IDC_CHECK_APPMENU_SEARCH_FUZZY,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 252, 140, 10

    CONTROL         "Show executables && settings links", IDC_CHECK_APPMENU_SEARCH_SYSTEM,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 266, 160, 10

    PUSHBUTTON      "Defaults", IDC_BTN_RESET_DEFAULTS, 4, 228, 52, 14
    DEFPUSHBUTTON   "OK",     IDOK,     110, 228, 46, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 162, 228, 46, 14
END
