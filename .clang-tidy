---
# Checks to enable. '-' prefix disables a check.
Checks: "clang-diagnostic-*,clang-analyzer-*,bugprone-*,cppcoreguidelines-*,modernize-*,-modernize-use-trailing-return-type,-cppcoreguidelines-avoid-magic-numbers,-cppcoreguidelines-pro-bounds-pointer-arithmetic,-cppcoreguidelines-pro-type-reinterpret-cast,-cppcoreguidelines-pro-type-static-cast-downcast,-cppcoreguidelines-pro-type-union-access,-cppcoreguidelines-pro-type-vararg"

# Only report issues in project source files, not in Windows/system headers.
HeaderFilterRegex: '.*\\src\\.*'

# Treat clang-tidy warnings as errors (set to '' for initial exploration).
WarningsAsErrors: ''

CheckOptions:
  - key: modernize-use-default-member-init.UseAssignment
    value: 'true'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: 'true'
...
