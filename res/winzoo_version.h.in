// line in CMakeLists.txt. Do not edit by hand and do not commit the generated
// copy in the build directory — bump the version in CMakeLists.txt instead.

#define WINZOO_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define WINZOO_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define WINZOO_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define WINZOO_VERSION_TWEAK @WINZOO_VERSION_TWEAK@

// Comma-separated form for VERSIONINFO FILEVERSION / PRODUCTVERSION.
#define WINZOO_VERSION_COMMA @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@WINZOO_VERSION_TWEAK@

// Dotted string forms.
#define WINZOO_VERSION_STRING      "@PROJECT_VERSION@"        // e.g. "0.4.0"
#define WINZOO_VERSION_STRING_FULL "@WINZOO_VERSION_FULL@"    // e.g. "0.4.0.0"

// Wide-string version for use in C++ UI text.
#define WINZOO_WIDEN2(x) L##x
